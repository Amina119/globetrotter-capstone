# Environment variables
.env
.env.*

# Docker
.dockerignore

# Data files (populated at runtime; seed catalogue is tracked)
backend/services/*/data/*.json
!backend/services/recommendation-service/data/destinations.json

# Per-service virtualenvs created while developing/testing locally
backend/services/*/.venv/
backend/gateway/.venv/
